<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The tablet is a shop appliance with one light theme, so the dark-mode
         launch window deliberately matches the light one: honouring the device's
         dark setting here would only produce a black flash before a cream app. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/panda_cream</item>
    </style>
</resources>
